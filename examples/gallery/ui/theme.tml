<?xml version="1.1" encoding="UTF-8"?>
<Theme xmlns="urn:tml:v1" name="gallery">
	<Color name="accent" for="titles, and the widgets that show a value" light="#5f5fd7" dark="#7aa2f7"/>
	<Color name="onAccent" for="text on a surface filled with the accent" value="#101014"/>
	<Color name="danger" for="an action that destroys something" light="#c4314b" dark="#f7768e"/>
	<Color name="line" for="rules, tracks and the borders of panels" light="#9ca0b0" dark="#3b4261"/>
	<Color name="dim" for="text the eye can pass over" light="#6c6f85" dark="#565f89"/>

	<Style name="title" bold="true" fg="{theme.accent}"/>
	<Style name="muted" faint="true" fg="{theme.dim}"/>
	<Style name="chip" bg="{theme.accent}" fg="{theme.onAccent}"/>
	<Style name="page" padding="0 1"/>
</Theme>

<?xml version="1.1" encoding="UTF-8"?>
<Component xmlns="urn:tml:v1" name="App">
	<Import src="./theme.tml"/>
	<Import src="./Panel.tml"/>

	<Property name="title" type="string" required="true"/>
	<Property name="query" type="string" default=""/>
	<Property name="services" type="string[]" default=""/>

	<Template>
		<Stack id="app" orientation="vertical" gap="1">
			<Text id="title" style="title">{title}</Text>

			<Panel id="filter" heading="Filter" width="*">
				<Stack orientation="horizontal" gap="1">
					<Text id="search-label" style="label">search</Text>
					<Search id="search" width="*"/>
				</Stack>
			</Panel>

			<Panel id="services" heading="Services" width="*">
				<Stack id="service-list" orientation="vertical">
					<Text id="no-matches" if="{not services}" style="muted">nothing matches {query}</Text>
					<For each="{services}" as="service">
						<Text>- {service}</Text>
					</For>
				</Stack>
			</Panel>

			<Text id="hint" style="muted">esc to quit</Text>
		</Stack>
	</Template>
</Component>

<?xml version="1.1" encoding="UTF-8"?>
<!--
	The whole screen, as its regions. docs/spec/tui/layout.md owns their order;
	this declares them, and the host computes every number.

	Each region is its own component, composed of the smaller ones it is made of:
	a message is a header, a body, its notes and a footer; the history is a
	scrolling region of messages; the composer is a frame around a caret row.
	Nothing here is a pre-rendered string handed over to be printed — the host
	says what a part MEANS and this decides what it looks like, which is the only
	arrangement in which changing the look is an edit to one file.

	The language has no arithmetic and no calls, which is the reason the split
	falls where it does rather than a limitation to work around: the row
	allocation ladder, the status line's demote-then-drop ladder, the wrap width
	and the caret's position are all facts about state, computed by the host that
	owns the state and consumed here as props.

	Region heights arrive as explicit cell counts because allocate() has already
	handed them out in priority order. A region that got no rows arrives empty
	and its `if` drops it, so a zero-height element never reaches the engine.
-->
<Component xmlns="urn:tml:v1" name="App">
	<Import src="./theme.tml"/>

	<!--
		One message's header: who said it, and when.

		The timestamp is pushed right by a star spacer rather than by a run of
		spaces the host counted. That arithmetic used to live in Go, which meant
		the gap was measured against a width the engine then laid out differently.
	-->
	<Component name="MessageHeader">
		<Property name="identity" type="string" default=""/>
		<Property name="identityStyle" type="string" default="ui.dim"/>
		<Property name="timestamp" type="string" default=""/>

		<Template>
			<Stack orientation="horizontal" width="*">
				<Text style="{identityStyle}">{identity}</Text>
				<Spacer width="*"/>
				<Text style="ui.dim" if="{timestamp}">{timestamp}</Text>
			</Stack>
		</Template>
	</Component>

	<!--
		What the event said. One token for the whole block: an interrupted answer
		arrives dim, so half a sentence does not read as the whole one while the
		eye is scrolling past it.
	-->
	<Component name="MessageBody">
		<Property name="body" type="string[]" default=""/>
		<Property name="bodyStyle" type="string" default="role.assistant"/>

		<Template>
			<Stack width="*">
				<For each="{body}" as="line">
					<Text style="{bodyStyle}">{line}</Text>
				</For>
			</Stack>
		</Template>
	</Component>

	<!--
		What the harness has to say about the event, as opposed to what the event
		said: a turn the projection did not send, escape sequences removed, a body
		too long to draw. Always warn, and never folded into the body — a
		diagnostic that reads as content is one the reader acts on.
	-->
	<Component name="MessageNotes">
		<Property name="notes" type="string[]" default=""/>

		<Template>
			<Stack width="*">
				<For each="{notes}" as="note">
					<Text style="state.warn">{note}</Text>
				</For>
			</Stack>
		</Template>
	</Component>

	<!--
		The metadata row: tokens, duration, cost, and whatever went wrong. The
		warnings are their own span so they keep their own colour; the two used to
		be one string with escape sequences baked into it, which is a region no
		theme can reach.
	-->
	<Component name="MessageFooter">
		<Property name="footerLead" type="string" default=""/>
		<Property name="footer" type="string" default=""/>
		<Property name="footerWarn" type="string" default=""/>

		<Template>
			<Stack orientation="horizontal" gap="1" width="*">
				<Text style="ui.dim">{footerLead}</Text>
				<Text style="ui.dim" if="{footer}">{footer}</Text>
				<Text style="state.warn" if="{footerWarn}">{footerWarn}</Text>
			</Stack>
		</Template>
	</Component>

	<!--
		One message. The host supplies the parts; this says where they go.

		`lead` is the blank row that separates one speaker from the next. It
		belongs to the block below it rather than the one above, so the last block
		on screen never trails one.

		A block scrolled half off the top arrives with its leading rows already
		dropped: an items control draws whole templates, and the host is the only
		side that knows where the scroll anchor sits.
	-->
	<DataTemplate name="Message">
		<Property name="lead" type="bool" default="false"/>
		<Property name="indent" type="int" default="0"/>
		<Property name="rail" type="string" default=""/>
		<Property name="railStyle" type="string" default="ui.rail"/>
		<Property name="showHeader" type="bool" default="false"/>
		<Property name="identity" type="string" default=""/>
		<Property name="identityStyle" type="string" default="ui.dim"/>
		<Property name="timestamp" type="string" default=""/>
		<Property name="body" type="string[]" default=""/>
		<Property name="bodyStyle" type="string" default="role.assistant"/>
		<Property name="notes" type="string[]" default=""/>
		<Property name="showFooter" type="bool" default="false"/>
		<Property name="footerLead" type="string" default=""/>
		<Property name="footer" type="string" default=""/>
		<Property name="footerWarn" type="string" default=""/>

		<Template>
			<Stack width="*" padding="0 0 0 {indent}">
				<Text if="{lead}"> </Text>
				<Stack orientation="horizontal" gap="1" width="*">
					<!-- The rail is one row tall beside a column that is not, which
					     is what puts the glyph on the block's first row and indents
					     the rest of it under the glyph. -->
					<Text style="{railStyle}">{rail}</Text>
					<Stack width="*">
						<MessageHeader if="{showHeader}" identity="{identity}"
							identityStyle="{identityStyle}" timestamp="{timestamp}"/>
						<MessageBody body="{body}" bodyStyle="{bodyStyle}"/>
						<MessageNotes notes="{notes}"/>
						<MessageFooter if="{showFooter}" footerLead="{footerLead}"
							footer="{footer}" footerWarn="{footerWarn}"/>
					</Stack>
				</Stack>
			</Stack>
		</Template>
	</DataTemplate>

	<!--
		The conversation: a scrolling region whose items are messages.

		scrollbar="never" is not a cosmetic choice. The transcript is an anchor
		walk backwards from the tail and never lays out the blocks above it, so
		the total is not known without paying the cost the windowing exists to
		avoid; a bar drawn from a number we do not have would report a position
		that is not the user's. It also reserves a column, which would wrap every
		row it was drawn beside. What says where the user is instead is the
		counter row.

		The counter takes a row rather than overwriting the newest message: a
		marker that destroys the content under it is a row of the conversation
		nobody can read.
	-->
	<Component name="History">
		<Property name="messages" type="record[]" default=""/>
		<Property name="counter" type="string" default=""/>

		<Template>
			<Stack height="*">
				<Scrollbox id="transcript" height="*" scrollbar="never">
					<Stack itemsSource="{messages}" itemTemplate="Message" width="*"/>
				</Scrollbox>
				<Stack orientation="horizontal" height="1" if="{counter}">
					<Spacer width="*"/>
					<Text style="ui.accent">{counter}</Text>
				</Stack>
			</Stack>
		</Template>
	</Component>

	<!--
		A §3a question rendered as state, not as a modal takeover: the user can
		scroll and keep typing while it is up.
	-->
	<Component name="PermissionPrompt">
		<Property name="title" type="string" default=""/>
		<Property name="height" type="int" default="0"/>
		<Property name="rows" type="string[]" default=""/>
		<Property name="choices" type="string[]" default=""/>

		<Template>
			<Border title="{title}" color="{theme.stateWarn}" height="{height}">
				<Stack>
					<For each="{rows}" as="row">
						<Text>{row}</Text>
					</For>
					<Stack orientation="horizontal" gap="2">
						<For each="{choices}" as="choice" index="i">
							<Text id="choice{i}" action="choose{i}">{choice}</Text>
						</For>
					</Stack>
				</Stack>
			</Border>
		</Template>
	</Component>

	<!--
		Harness state, not conversation. Capped at three rows by the layout, so
		each is declared rather than looped: a notice's level decides its style,
		and a list of strings cannot carry one per item.
	-->
	<Component name="Notices">
		<Property name="notice0" type="string" default=""/>
		<Property name="notice0Style" type="string" default="role.system"/>
		<Property name="notice1" type="string" default=""/>
		<Property name="notice1Style" type="string" default="role.system"/>
		<Property name="notice2" type="string" default=""/>
		<Property name="notice2Style" type="string" default="role.system"/>

		<Template>
			<Stack width="*">
				<Text style="{notice0Style}" if="{notice0}">{notice0}</Text>
				<Text style="{notice1Style}" if="{notice1}">{notice1}</Text>
				<Text style="{notice2Style}" if="{notice2}">{notice2}</Text>
			</Stack>
		</Template>
	</Component>

	<!--
		Every segment arrives already demoted to the spelling the ladder chose, and
		empty means dropped. The default permission mode renders nothing at all: an
		indicator for the default state teaches the eye to skip the segment.
	-->
	<Component name="StatusLine">
		<Property name="bypass" type="string" default=""/>
		<Property name="activity" type="string" default=""/>
		<Property name="mode" type="string" default=""/>
		<Property name="goal" type="string" default=""/>
		<Property name="goalStyle" type="string" default="ui.dim"/>
		<Property name="context" type="string" default=""/>
		<Property name="model" type="string" default=""/>
		<Property name="cost" type="string" default=""/>
		<Property name="git" type="string" default=""/>
		<Property name="gitStyle" type="string" default="ui.dim"/>
		<Property name="ci" type="string" default=""/>
		<Property name="ciStyle" type="string" default="ui.dim"/>
		<Property name="clock" type="string" default=""/>
		<Property name="dropped" type="bool" default="false"/>
		<Property name="transient" type="string" default=""/>

		<Template>
			<Stack orientation="horizontal" gap="2" height="1">
				<Text style="state.error" if="{bypass}">{bypass}</Text>
				<Text style="state.pending" if="{activity}">{activity}</Text>
				<Text style="ui.accent" if="{mode}">{mode}</Text>
				<Text style="{goalStyle}" if="{goal}">{goal}</Text>
				<Text style="ui.dim" if="{context}">{context}</Text>
				<Text style="ui.dim" if="{model}">{model}</Text>
				<Text style="ui.dim" if="{cost}">{cost}</Text>
				<Text style="state.warn" if="{transient}">{transient}</Text>
				<Spacer width="*"/>
				<Text style="ui.dim" if="{dropped}">…</Text>
				<Text style="{gitStyle}" if="{git}">{git}</Text>
				<Text style="{ciStyle}" if="{ci}">{ci}</Text>
				<Text style="ui.dim" if="{clock}">{clock}</Text>
			</Stack>
		</Template>
	</Component>

	<!-- The messages typed during a run, waiting for the boundary that delivers
	     them: a header the layout ranks above the hint row, and the entries. -->
	<Component name="QueueStack">
		<Property name="header" type="string" default=""/>
		<Property name="headerStyle" type="string" default="ui.dim"/>
		<Property name="rows" type="string[]" default=""/>
		<Property name="height" type="int" default="0"/>

		<Template>
			<Stack height="{height}">
				<Text style="{headerStyle}">{header}</Text>
				<For each="{rows}" as="row">
					<Text style="ui.dim">{row}</Text>
				</For>
			</Stack>
		</Template>
	</Component>

	<!--
		The composer's box, and the one terminal size that cannot afford it.

		Every other region here is flat text in the same column, so without an
		edge there is nothing that says where the thing taking keystrokes
		begins. But the box is two rows, and layout.md's floor is 20x5 with
		those five rows named — status, composer, and the transcript's three.
		Nothing may take a row from the transcript's minimum, a border least of
		all, so below the height where it fits the composer is drawn without
		one rather than the whole screen being refused.

		The body is written once, at the call site, and lands in whichever of
		these two the host selected. Both flags are computed there because the
		language has no `not`.
	-->
	<Component name="ComposerFrame">
		<Property name="boxed" type="bool" default="true"/>
		<Property name="unboxed" type="bool" default="false"/>
		<Property name="boxHeight" type="int" default="3"/>

		<Template>
			<Border kind="rounded" color="{theme.uiRail}"
				width="*" height="{boxHeight}" if="{boxed}">
				<Slot/>
			</Border>
			<Stack width="*" if="{unboxed}">
				<Slot/>
			</Stack>
		</Template>
	</Component>

	<!--
		The row holding the caret, as three spans: the text before it, the cell
		under it, and the text after it. The caret is ours to place, so styling it
		is styling rather than string surgery.

		The ghost occupies the caret's own cell when the box is empty, so the
		affordance reads as text that is not yours yet rather than as content with
		a block sitting in it. And the caret is marked only while the composer has
		focus — a caret in a box that is not taking input is a lie about where the
		keystrokes are going — while the cell is drawn either way, so the row does
		not change width when focus moves.
	-->
	<Component name="CaretRow">
		<Property name="prefix" type="string" default=""/>
		<Property name="before" type="string" default=""/>
		<Property name="cell" type="string" default=" "/>
		<Property name="after" type="string" default=""/>
		<Property name="ghost" type="string" default=""/>
		<Property name="showGhost" type="bool" default="false"/>
		<Property name="showCaret" type="bool" default="true"/>
		<Property name="showPlainCell" type="bool" default="false"/>

		<Template>
			<Stack orientation="horizontal">
				<Text style="role.user">{prefix}</Text>
				<Text>{before}</Text>
				<Text style="ui.ghost" if="{showGhost}">{ghost}</Text>
				<Text style="ui.caret" if="{showCaret}">{cell}</Text>
				<Text if="{showPlainCell}">{cell}</Text>
				<Text>{after}</Text>
			</Stack>
		</Template>
	</Component>

	<!-- The thing taking keystrokes: a frame, the lines above the caret, the
	     caret's own row, and the lines below it. -->
	<Component name="Composer">
		<Property name="height" type="int" default="1"/>
		<Property name="boxHeight" type="int" default="3"/>
		<Property name="boxed" type="bool" default="true"/>
		<Property name="unboxed" type="bool" default="false"/>
		<Property name="above" type="string[]" default=""/>
		<Property name="below" type="string[]" default=""/>
		<Property name="caretPrefix" type="string" default=""/>
		<Property name="caretBefore" type="string" default=""/>
		<Property name="caretCell" type="string" default=" "/>
		<Property name="caretAfter" type="string" default=""/>
		<Property name="ghost" type="string" default=""/>
		<Property name="showGhost" type="bool" default="false"/>
		<Property name="showCaret" type="bool" default="true"/>
		<Property name="showPlainCell" type="bool" default="false"/>

		<Template>
			<ComposerFrame boxed="{boxed}" unboxed="{unboxed}" boxHeight="{boxHeight}">
				<Stack width="*" height="{height}">
					<For each="{above}" as="row">
						<Text>{row}</Text>
					</For>
					<CaretRow prefix="{caretPrefix}" before="{caretBefore}"
						cell="{caretCell}" after="{caretAfter}" ghost="{ghost}"
						showGhost="{showGhost}" showCaret="{showCaret}"
						showPlainCell="{showPlainCell}"/>
					<For each="{below}" as="row">
						<Text>{row}</Text>
					</For>
				</Stack>
			</ComposerFrame>
		</Template>
	</Component>

	<!-- The tier-2 bindings that are live right now, already cut to the columns
	     they fit in. -->
	<Component name="HintRow">
		<Property name="hints" type="string[]" default=""/>

		<Template>
			<Stack orientation="horizontal" gap="3" height="1">
				<For each="{hints}" as="hint">
					<Text style="ui.dim">{hint}</Text>
				</For>
			</Stack>
		</Template>
	</Component>

	<!-- The conversation on screen: one record per message, and the marker that
	     says how much is below the view. -->
	<Property name="messages" type="record[]" default=""/>
	<Property name="counter" type="string" default=""/>

	<!-- Permission prompt, pinned to the transcript tail. -->
	<Property name="showPrompt" type="bool" default="false"/>
	<Property name="promptHeight" type="int" default="0"/>
	<Property name="promptTitle" type="string" default=""/>
	<Property name="promptRows" type="string[]" default=""/>
	<Property name="promptChoices" type="string[]" default=""/>

	<Property name="notice0" type="string" default=""/>
	<Property name="notice0Style" type="string" default="role.system"/>
	<Property name="notice1" type="string" default=""/>
	<Property name="notice1Style" type="string" default="role.system"/>
	<Property name="notice2" type="string" default=""/>
	<Property name="notice2Style" type="string" default="role.system"/>

	<!-- Status line. Every segment arrives already demoted to the spelling the
	     ladder chose, and empty means dropped. -->
	<Property name="bypass" type="string" default=""/>
	<Property name="activity" type="string" default=""/>
	<Property name="mode" type="string" default=""/>
	<Property name="goal" type="string" default=""/>
	<Property name="goalStyle" type="string" default="ui.dim"/>
	<Property name="context" type="string" default=""/>
	<Property name="model" type="string" default=""/>
	<Property name="cost" type="string" default=""/>
	<Property name="git" type="string" default=""/>
	<Property name="gitStyle" type="string" default="ui.dim"/>
	<Property name="ci" type="string" default=""/>
	<Property name="ciStyle" type="string" default="ui.dim"/>
	<Property name="clock" type="string" default=""/>
	<Property name="dropped" type="bool" default="false"/>
	<Property name="transient" type="string" default=""/>
	<Property name="rule" type="string" default=""/>

	<!-- Queue stack: a header the layout ranks above the hint row, and the
	     entries in full. -->
	<Property name="showQueue" type="bool" default="false"/>
	<Property name="queueHeader" type="string" default=""/>
	<Property name="queueHeaderStyle" type="string" default="ui.dim"/>
	<Property name="queueRows" type="string[]" default=""/>
	<Property name="queueHeight" type="int" default="0"/>

	<!-- Composer. The caret row is three spans because the caret is ours to
	     place: the text before it, the cell under it, and the text after it. -->
	<Property name="composerHeight" type="int" default="1"/>
	<Property name="composerBoxHeight" type="int" default="3"/>
	<Property name="composerBoxed" type="bool" default="true"/>
	<Property name="composerUnboxed" type="bool" default="false"/>
	<Property name="composerAbove" type="string[]" default=""/>
	<Property name="caretPrefix" type="string" default=""/>
	<Property name="caretBefore" type="string" default=""/>
	<Property name="caretCell" type="string" default=" "/>
	<Property name="caretAfter" type="string" default=""/>
	<Property name="composerBelow" type="string[]" default=""/>
	<Property name="ghost" type="string" default=""/>
	<Property name="showGhost" type="bool" default="false"/>
	<Property name="showCaret" type="bool" default="true"/>
	<Property name="showPlainCell" type="bool" default="false"/>

	<Property name="showHints" type="bool" default="false"/>
	<Property name="hints" type="string[]" default=""/>

	<Template>
		<Stack height="*">
			<!-- The history is the ladder's last claimant: it takes everything the
			     regions below it did not, which is a star share rather than a
			     number. A scrolling region measures its children against unlimited
			     height, so an explicit one fights what makes it scroll. -->
			<History messages="{messages}" counter="{counter}"/>

			<PermissionPrompt if="{showPrompt}" title="{promptTitle}"
				height="{promptHeight}" rows="{promptRows}"
				choices="{promptChoices}"/>

			<Notices notice0="{notice0}" notice0Style="{notice0Style}"
				notice1="{notice1}" notice1Style="{notice1Style}"
				notice2="{notice2}" notice2Style="{notice2Style}"/>

			<!-- The boundary between what the conversation said and what the
			     harness is reporting about it. The host builds the run of
			     glyphs, because its width is arithmetic. -->
			<Text style="ui.dim" height="1" if="{rule}">{rule}</Text>

			<StatusLine bypass="{bypass}" activity="{activity}" mode="{mode}"
				goal="{goal}" goalStyle="{goalStyle}" context="{context}"
				model="{model}" cost="{cost}" git="{git}" gitStyle="{gitStyle}"
				ci="{ci}" ciStyle="{ciStyle}" clock="{clock}" dropped="{dropped}"
				transient="{transient}"/>

			<QueueStack if="{showQueue}" header="{queueHeader}"
				headerStyle="{queueHeaderStyle}" rows="{queueRows}"
				height="{queueHeight}"/>

			<Composer height="{composerHeight}" boxHeight="{composerBoxHeight}"
				boxed="{composerBoxed}" unboxed="{composerUnboxed}"
				above="{composerAbove}" below="{composerBelow}"
				caretPrefix="{caretPrefix}" caretBefore="{caretBefore}"
				caretCell="{caretCell}" caretAfter="{caretAfter}" ghost="{ghost}"
				showGhost="{showGhost}" showCaret="{showCaret}"
				showPlainCell="{showPlainCell}"/>

			<HintRow if="{showHints}" hints="{hints}"/>
		</Stack>
	</Template>
</Component>

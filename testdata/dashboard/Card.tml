<?xml version="1.1" encoding="UTF-8"?>
<Component xmlns="urn:tml:v1" name="Card">
	<Property name="label" type="string" required="true"/>
	<Property name="width" type="length" default="auto"/>

	<Template>
		<Box style="card" width="{width}">
			<Stack orientation="vertical">
				<Text style="card.title">{label}</Text>
				<Slot/>
				<Slot name="actions">
					<Text style="muted">no actions</Text>
				</Slot>
			</Stack>
		</Box>
	</Template>
</Component>

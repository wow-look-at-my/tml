<?xml version="1.1" encoding="UTF-8"?>
<Component xmlns="urn:tml:v1" name="Burst">
	<Property name="value" type="string" default=""/>
	<Property name="cursor" type="int" default="0"/>
	<Property name="offset" type="int" default="0"/>
	<Property name="lines" type="string[]" default=""/>
	<Template>
		<Stack>
			<Textbox id="name" action="rename" value="{value}" cursor="{cursor}"/>
			<Text if="{value}">typed</Text>
			<Button id="go" action="go" label="Go"/>
			<Scrollbox id="log" height="3" offset="{offset}" scrollbar="never">
				<Stack>
					<For each="{lines}" as="line">
						<Text>{line}</Text>
					</For>
				</Stack>
			</Scrollbox>
		</Stack>
	</Template>
</Component>
